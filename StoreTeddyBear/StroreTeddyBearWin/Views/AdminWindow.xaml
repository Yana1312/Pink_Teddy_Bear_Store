<Window x:Class="StroreTeddyBearWin.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StroreTeddyBearWin.Views"
        mc:Ignorable="d"
        Title="Окно добавления/редактирования товара" Height="450" Width="800"
        WindowState="Maximized"
        Icon="/ElementsVisualization/Image/Профиль.png">
    <Grid Background="#FFF4F4">
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="75"/>
        </Grid.ColumnDefinitions>

        <Border CornerRadius="35" Background="#F8BED4" Grid.Row="0" Margin="10 20">
            <TextBox x:Name="SearchTextBox" Style="{StaticResource MaterialDesignTextBox}" VerticalAlignment="Center" Margin="40 0" FontSize="15" TextChanged="SearchTextBox_TextChanged"/>
        </Border>

        <Grid Grid.Column="1" Margin="0 ">
            <Image Width="70" Height="70" Source="/ElementsVisualization/Image/фон для правой меню.png" />
            <Image Source="/ElementsVisualization/Image/Профиль обратный.png" x:Name="ProfileImg" Height="50" MouseDown="ProfileImg_MouseDown"   />
        </Grid>

        <TabControl Grid.Row="2" Grid.ColumnSpan="2" Background="White" Margin="10">
            <TabItem Header="Товары">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <ItemsControl x:Name="ToysItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF4F4" 
                                            BorderBrush="#F8BED4" 
                                            BorderThickness="2"
                                            CornerRadius="10"
                                            Margin="5"
                                            MouseDown="Border_MouseDown"
                                            Width="180"
                                            Height="200">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" 
                                           Text="{Binding ArticulToy}" 
                                           FontSize="12"
                                           Foreground="#666666"/>

                                            <TextBlock Grid.Row="1" 
                                           Text="{Binding Title}" 
                                           FontWeight="Bold"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,5"/>

                                            <TextBlock Grid.Row="2" 
                                           Text="{Binding Descriptionn}" 
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           MaxHeight="40"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#666666"/>

                                            <TextBlock Grid.Row="3" 
                                           Text="{Binding Price, StringFormat={}{0}₽}" 
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#EE9EB8"
                                           Margin="0,5,0,0"/>

                                            <TextBlock Grid.Row="4" 
                                                       Text="{Binding QuantityInStock, StringFormat={}В наличии: {0} шт.}" 
                                                       FontSize="10"
                                                       Foreground="#666666"
                                                       Margin="0,2,0,0"/>

                                            <StackPanel Grid.Row="5" Orientation="Vertical" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding Height}" FontSize="9" Foreground="#888888"/>
                                                <TextBlock Text="{Binding Weight}" FontSize="9" Foreground="#888888"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <TabItem Header="Заказы">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                            <ComboBox x:Name="StatusFilterComboBox" Width="150" Margin="10 0 0 0"
                                      Style="{StaticResource MaterialDesignComboBox}"
                                      SelectionChanged="StatusFilterComboBox_SelectionChanged"
                                      FontSize="11">
                                <ComboBoxItem Content="Все статусы" IsSelected="True"/>
                                <ComboBoxItem Content="ожидает подтверждения"/>
                                <ComboBoxItem Content="в обработке"/>
                                <ComboBoxItem Content="отгружен"/>
                                <ComboBoxItem Content="доставлен"/>
                            </ComboBox>

                            <Button Content="Обновить список" Click="RefreshOrdersBtn_Click"
                                    Style="{StaticResource RoundedSquertBtnStyle}"
                                    FontSize="11" Height="25" Margin="10 0 0 0"/>
                        </StackPanel>

                        <ItemsControl x:Name="OrdersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF4F4" 
                                            CornerRadius="10"
                                            Margin="5"
                                            Padding="15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding IdOrder, StringFormat='Заказ №{0}'}" 
                                                           FontSize="14"/>
                                                <TextBlock Text="{Binding DateOrder, StringFormat='Дата: {0:dd.MM.yyyy HH:mm}'}" 
                                                           FontSize="12" Foreground="#666666"/>
                                                <TextBlock Text="{Binding TotalAmount, StringFormat='Сумма: {0}₽'}" 
                                                           FontSize="12" Foreground="#666666"/>
                                                <TextBlock Text="{Binding StatusOrder, StringFormat='Статус: {0}'}" 
                                                           FontSize="12" Foreground="#666666"/>
                                                <TextBlock Text="{Binding AdressOrder, StringFormat='Адрес: {0}', FallbackValue='{}Адрес: не указан'}" 
                                                           FontSize="12" Foreground="#666666" TextWrapping="Wrap"/>

                                                <TextBlock Text="Товары:" Margin="0 5 0 0"/>
                                                <ItemsControl ItemsSource="{Binding Orderitems}" Margin="0 5 0 0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F8BED4" CornerRadius="5" Padding="5" Margin="0 2">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding ArticulToyNavigation.Title}" 
                                                                               FontSize="11"/>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Quantity, StringFormat='{}{0} x'}" 
                                                                                   FontSize="11" Margin="0 0 5 0"/>
                                                                        <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0}'}" 
                                                                                   FontSize="11"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Width="150" Margin="10 0 0 0">
                                                <TextBlock Text="Изменить статус:" FontSize="12"/>
                                                <ComboBox x:Name="StatusComboBox" 
                                                          Style="{StaticResource MaterialDesignComboBox}"
                                                          SelectedValue="{Binding StatusOrder}"
                                                          SelectionChanged="StatusComboBox_SelectionChanged"
                                                        Tag="{Binding IdOrder}"
                                                          FontSize="11" Margin="0 5 0 5">
                                                    <ComboBoxItem Content="отгружен"/>
                                                    <ComboBoxItem Content="доставлен"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Left" Grid.ColumnSpan="2">
            <StackPanel Margin="4" Orientation="Horizontal">
                <Button Margin="3" x:Name="AddBearBtn" Content="Добавить игрушку" Style="{StaticResource RoundedButtonStyle}" Background="#F8BED4" Click="AddBearBtn_Click"/>
                <Button Margin="3" x:Name="DeleteBearBtn" Content="Удалить игрушку" Style="{StaticResource RoundedButtonStyle}" Background="#F8BED4" Click="DeleteBearBtn_Click"/>
                <Button Margin="3" x:Name="RedacBearBtn" Content="Редактировать игрушку" Style="{StaticResource RoundedButtonStyle}" Background="#F8BED4" Click="RedacBearBtn_Click"/>
            </StackPanel>
        </Viewbox>

        <Grid x:Name="AddBearGrid" Grid.ColumnSpan="2" Grid.RowSpan="3" Visibility="Hidden">
            <Grid.Background>
                <SolidColorBrush Color="#FF6E6969" Opacity="0.6"/>
            </Grid.Background>
            <Viewbox VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Uniform">
                <Border 
                    Margin="60"
                    BorderThickness="3"
                    BorderBrush="#fffff4f4"
                    CornerRadius="45">
                    <Border.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FFFAC0D5"/>
                            <GradientStop Color="#FFEB85A7" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="10 3 10 0" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="Добавление игрушки" FontSize="17" Style="{StaticResource TextBlockStyle}"/>
                            <Button x:Name="CrossBtn" Click="CrossBtn_Click" Height="25" Width="25" BorderThickness="0" Grid.Column="1" Background="Transparent">
                                <Image Source="/ElementsVisualization/Image/cross.png" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="Введите название игрушки" Style="{StaticResource TextBlockStyle}" Margin="10 3"/>
                        <TextBox Grid.Row="2" x:Name="UserNameRegistrationTbox" Style="{StaticResource RoundedTextBoxStyle}"/>
                        <TextBlock Grid.Row="3" Text="Введите описание" Style="{StaticResource TextBlockStyle}" Margin="10 3"/>
                        <TextBox Grid.Row="4" Height="50" x:Name="UserEmailRegistrationTbox" Style="{StaticResource RoundedTextBoxStyle}"/>
                        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0 10 0 0">
                            <TextBlock Text="Введите цену" Margin="10 0 33 0" Style="{StaticResource TextBlockStyle}"/>
                            <TextBox x:Name="PriceTbox" Width="120" Style="{StaticResource RoundedTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0 10 0 0">
                            <TextBlock Text="Введите рост" Margin="10 0 33 0" Style="{StaticResource TextBlockStyle}"/>
                            <TextBox x:Name="HeightTbox" Width="120" Style="{StaticResource RoundedTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0 10 0 0">
                            <TextBlock Text="Введите вес" Margin="10 0 41 0" Style="{StaticResource TextBlockStyle}"/>
                            <TextBox x:Name="WeightTbox" Width="120" Style="{StaticResource RoundedTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0 10 0 0">
                            <TextBlock Text="Введите количество" Width="70" TextWrapping="Wrap" Margin="10 0 39 0" Style="{StaticResource TextBlockStyle}"/>
                            <TextBox x:Name="QuantityTbox" Width="120" Style="{StaticResource RoundedTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0 5 0 0">
                            <Button Width="90" x:Name="GetPathBtn" Margin="0 0 30 0" Style="{StaticResource RoundedButtonStyle}" Height="35" Click="GetPathBtn_Click">
                                <TextBlock Text="Выбрать изображение" TextWrapping="Wrap"/>
                            </Button>
                            <TextBox x:Name="PathToImageTbox" IsReadOnly="True" Width="120" Style="{StaticResource RoundedTextBoxStyle}"/>
                        </StackPanel>

                        <Button Grid.Row="10" x:Name="SetUpBearBtn" Content="Добавить" Width="200" Style="{StaticResource RoundedButtonStyle}" Margin="20 10 20 10" FontSize="15" Height="27" Click="SetUpBearBtn_Click"/>
                    </Grid>
                </Border>
            </Viewbox>
        </Grid>
    </Grid>
</Window>